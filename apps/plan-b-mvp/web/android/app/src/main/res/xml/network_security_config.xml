<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only; system CAs only. Debug builds may talk to a LAN dev server: see src/debug/res/xml if you need that. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
