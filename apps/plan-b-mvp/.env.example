# Names only, never values. Copy to .env (git-ignored) or set these in the host's dashboard. Accounts are off unless ACCOUNTS_SECRET_KEY is set.
# See docs/engineering/accounts.md and infra/plan-b-mvp/README.md.
ACCOUNTS_SECRET_KEY=
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_FILE=
APPLE_DOMAIN_ASSOCIATION=
APPLE_DOMAIN_ASSOCIATION_FILE=
APPLE_APP_SITE_ASSOCIATION_JSON=
ANDROID_ASSETLINKS_JSON=
# Development only (ignored unless PLANB_DEV=1): a random secret key is generated per run and a fake test provider can be switched on.
PLANB_DEV=
ACCOUNTS_FAKE_PROVIDER=
